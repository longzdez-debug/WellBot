global:
  resolve_timeout: 5m

route:
  receiver: wellbot-webhook
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: wellbot-webhook
    webhook_configs:
      - url: https://REPLACE_WITH_YOUR_ALERT_RECEIVER.example/alerts
        send_resolved: true
