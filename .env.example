# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Docker Compose database password (required by deploy.sh / docker compose)
DB_PASSWORD=replace_with_a_long_random_password

# Direct/local development database URL. Docker Compose builds its own DATABASE_URL.
DATABASE_URL=postgresql://bot_user:replace_password@localhost:5432/wellbot

# HUNT Telegram Mini App (optional but recommended for production)
# Must be a public HTTPS URL when Telegram opens the Mini App.
HUNT_WEBAPP_URL=
HUNT_WEB_PORT=8080

# Realtime monitor tuning
# 5 seconds is the default polling target; actual source/API visibility can add latency.
PARSE_INTERVAL_SECONDS=5
# Safe default for the 128 MiB Deplexo hobby container. Increase only after measuring memory.
PARSE_CONCURRENCY=5

# Runtime
NODE_ENV=production
LOG_LEVEL=info
