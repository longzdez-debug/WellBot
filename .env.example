# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Production managed PostgreSQL connection (Supabase). Store the real value only in encrypted deployment secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local development only.
DB_PASSWORD=replace_with_a_long_random_password

# WellBOT Telegram Mini App
# Must be a public HTTPS URL when Telegram opens the Mini App.
# WELLBOT_WEBAPP_URL is preferred; WEBAPP_URL / PUBLIC_URL are accepted as fallbacks.
WELLBOT_WEBAPP_URL=
PORT=3000

# WellBOT PRO — Telegram Stars monthly subscription
WELLBOT_PRO_PRICE_STARS=199
# Optional public terms URL shown during checkout
WELLBOT_TERMS_URL=

# Kufar access fallback. Kufar does not publish a documented public developer API.
# When DEPLEXO's egress receives HTTP 403 from Kufar, set a managed provider key
# to keep monitoring alive without bypassing Kufar access controls.
KUFAR_REEF_API_KEY=
KUFAR_REEF_API_URL=https://api.reefapi.com/kufar/v1/search

# Realtime monitor tuning
# Production default. Actual detection latency also depends on source visibility,
# network/parser latency and Telegram delivery.
PARSE_INTERVAL_SECONDS=1
PARSE_CONCURRENCY=16
PARSE_TIMEOUT_MS=6000

# Durable notification outbox
NOTIFICATION_MAX_ATTEMPTS=12
NOTIFICATION_RETENTION_DAYS=14
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_CONCURRENCY=8
NOTIFICATION_DRAIN_MS=500

# Database protection
# Pause scheduler database work after provider quota/connection-limit errors.
DATABASE_ERROR_BACKOFF_MS=30000

# Runtime
NODE_ENV=production
LOG_LEVEL=info
DISPLAY_TIMEZONE=Europe/Minsk

# Comma-separated Telegram IDs allowed to use the admin panel
TELEGRAM_ADMIN_IDS=

# Production watchdog (GitHub Actions; no secrets are stored in the repository).
# Configure these as GitHub Actions repository secrets.
# WELLBOT_PROD_URL=https://your-deplexo-domain
# WELLBOT_ALERT_BOT_TOKEN=Telegram bot token used only for failure alerts
# WELLBOT_ALERT_CHAT_ID=Telegram chat ID receiving watchdog alerts

# External PostgreSQL backup storage (GitHub Actions secrets).
# BACKUP_S3_ENDPOINT=https://...
# BACKUP_S3_BUCKET=wellbot-backups
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# BACKUP_S3_REGION=auto
