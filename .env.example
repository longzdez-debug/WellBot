# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL Database URL
DATABASE_URL=postgresql://bot_user:your_password@localhost:5432/wellbot

# Yandex Maps API Key (get from https://developer.tech.yandex.ru/)
YANDEX_MAPS_API_KEY=your_yandex_api_key_here
# Optional: separate key for Static Maps API (must have no IP/Referer restrictions,
# because Telegram servers download the map images, not your bot)
YANDEX_STATIC_MAPS_API_KEY=your_yandex_static_maps_api_key_here

# HUNT Telegram Mini App
# Public HTTPS URL pointing to this project's /web folder (or HUNT_WEB_PORT server below)
HUNT_WEBAPP_URL=https://hunt.example.com/
# Optional built-in static server for the Mini App. Put a reverse proxy in front of it for HTTPS.
HUNT_WEB_PORT=8080

# Realtime monitor tuning
# 5 seconds gives near-instant detection while avoiding unnecessary request pressure.
# Minimum supported value is 1 second.
PARSE_INTERVAL_SECONDS=5
# Number of search URLs parsed in parallel.
PARSE_CONCURRENCY=20

# Runtime
NODE_ENV=production
LOG_LEVEL=info
