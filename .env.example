# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Docker Compose database password (required by deploy.sh / docker compose)
DB_PASSWORD=replace_with_a_long_random_password

# Direct/local development database URL. Docker Compose builds its own DATABASE_URL.
DATABASE_URL=postgresql://bot_user:replace_password@localhost:5432/wellbot

# WellBOT Telegram Mini App
# Must be a public HTTPS URL when Telegram opens the Mini App.
# WELLBOT_WEBAPP_URL is preferred; WEBAPP_URL / PUBLIC_URL are accepted as fallbacks.
WELLBOT_WEBAPP_URL=
WELLBOT_WEB_PORT=8080

# Kufar access fallback. Kufar does not publish a documented public developer API.
# When DEPLEXO's egress receives HTTP 403 from Kufar, set a managed provider key
# to keep monitoring alive without bypassing Kufar access controls.
KUFAR_REEF_API_KEY=
KUFAR_REEF_API_URL=https://api.reefapi.com/kufar/v1/search

# Realtime monitor tuning
# Production default. Actual detection latency also depends on source visibility,
# network/parser latency and Telegram delivery.
PARSE_INTERVAL_SECONDS=0.25
PARSE_CONCURRENCY=16
PARSE_TIMEOUT_MS=6000

# Durable notification outbox
NOTIFICATION_MAX_ATTEMPTS=12
NOTIFICATION_RETENTION_DAYS=14
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_CONCURRENCY=8
NOTIFICATION_DRAIN_MS=50

# Runtime
NODE_ENV=production
LOG_LEVEL=info
DISPLAY_TIMEZONE=Europe/Minsk
