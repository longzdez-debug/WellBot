global:
  resolve_timeout: 5m

route:
  receiver: wellbot-telegram
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: wellbot-telegram
    telegram_configs:
      - bot_token: "${WELLBOT_ALERT_BOT_TOKEN}"
        chat_id: ${WELLBOT_ALERT_CHAT_ID}
        send_resolved: true
